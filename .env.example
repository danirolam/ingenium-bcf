# --- Anthropic (primary AI) ---
# The main engine: the legal-delta interpreter (stage 2), the client-impact scorer
# (stage 3), and the client brief + approval email (stage 4). If empty, every AI step
# falls back to deterministic, real-looking output (the app stays fully usable).
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the models.
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_SCALPEL_MODEL=   # model for the partial-edit "scalpel"; defaults to ANTHROPIC_MODEL

# --- Google Gemini (legacy / fallback) ---
# Optional. Powers the legacy full-text delta path and the keyless-Anthropic fallback
# interpreter. Not needed when ANTHROPIC_API_KEY is set.
# Get a free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Vercel Blob (full Act corpus) ---
# Optional. Serves the full 964-Act federal corpus for two-sided diffs. Without it, only
# the 5 bundled demo Acts resolve. SENSITIVE -- copy from the Vercel dashboard, never commit.
BLOB_READ_WRITE_TOKEN=

# --- Resend (transactional email) ---
# Optional. If empty, lawyer notification emails are simulated (logged, not sent).
# Get a key at: https://resend.com
RESEND_API_KEY=
RESEND_FROM=Ingenium <onboarding@resend.dev>
NOTIFY_EMAIL=lawyer@example.com

# --- Server ---
PORT=8787
